        "capture": {"$ref": "#/$defs/capture"},
        "roots": {"type": "array", "items": {"type": "object", "required": ["root_id", "complete"], "properties": {"root_id": {"$ref": "#/$defs/id"}, "complete": {"type": "boolean"}, "tree_hash": {"$ref": "#/$defs/sha256"}, "excluded": {"type": "array", "items": {"type": "string"}}, "errors": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}, "additionalProperties": true}},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/fsNode"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": true
    },
    "nodeState": {
      "type": "object",
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "tree_hash": {"$ref": "#/$defs/sha256"},
        "metadata_hash": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "mtime": {"$ref": "#/$defs/timestamp"},
        "mode": {"type": "string"},
        "artifact_ref": {"$ref": "#/$defs/artifactRef"}
      },
      "additionalProperties": true
    },
    "fsChange": {
      "type": "object",
      "required": ["operation", "node_type", "attribution"],
      "properties": {
        "operation": {"enum": ["create", "modify", "delete", "rename", "metadata", "symlink_target", "unknown"]},
        "node_type": {"enum": ["file", "directory", "symlink", "junction", "device", "socket", "other", "unknown"]},
        "path_before": {"$ref": "#/$defs/fsPath"},
        "path_after": {"$ref": "#/$defs/fsPath"},
        "before": {"$ref": "#/$defs/nodeState"},
        "after": {"$ref": "#/$defs/nodeState"},
        "diff": {"type": "object", "properties": {"kind": {"enum": ["unified", "structured", "binary_summary", "image", "none", "unavailable", "other"]}, "summary": {"type": "string"}, "artifact_ref": {"$ref": "#/$defs/artifactRef"}, "truncated": {"type": "boolean"}}, "additionalProperties": true},
        "attribution": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["caused", "correlated", "unknown", "not_applicable"]}, "event_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "process_ids": {"type": "array", "items": {"type": ["string", "integer"]}}, "basis": {"type": "string"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}}, "additionalProperties": true},
        "possible_rename_group": {"$ref": "#/$defs/id"}
      },
      "anyOf": [{"required": ["path_before"]}, {"required": ["path_after"]}],
      "additionalProperties": true
    },
    "fsChangeSet": {
      "type": "object",
      "required": ["document_type", "spec_version", "run_id", "change_set_id", "from_snapshot_id", "to_snapshot_id", "coverage", "changes"],
      "properties": {
        "document_type": {"const": "fs_change_set"},
        "spec_version": {"$ref": "#/$defs/specVersion"},
        "run_id": {"$ref": "#/$defs/id"},
        "change_set_id": {"$ref": "#/$defs/id"},
        "from_snapshot_id": {"$ref": "#/$defs/id"},
        "to_snapshot_id": {"$ref": "#/$defs/id"},
        "detected_at": {"$ref": "#/$defs/timestamp"},
        "observation_id": {"$ref": "#/$defs/id"},
        "capture": {"$ref": "#/$defs/capture"},
        "coverage": {"type": "object", "required": ["roots", "complete"], "properties": {"roots": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "complete": {"type": "boolean"}, "limitations": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/fsChange"}},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["document_type", "spec_version", "run_id", "evaluation_id", "evaluator", "created_at", "verdicts"],
      "properties": {
        "document_type": {"const": "evaluation"},
        "spec_version": {"$ref": "#/$defs/specVersion"},
        "run_id": {"$ref": "#/$defs/id"},
        "evaluation_id": {"$ref": "#/$defs/id"},
        "evaluator": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"enum": ["human", "rule", "llm", "hybrid"]}, "id": {"$ref": "#/$defs/id"}, "version": {"type": "string"}, "model": {"type": "object", "additionalProperties": true}}, "additionalProperties": true},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "rubric_version": {"type": "string"},
        "selected_path_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "verdicts": {"type": "array", "items": {"type": "object", "required": ["assertion_id", "target", "outcome", "evidence_event_ids"], "properties": {"assertion_id": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/scopeRef"}, "path_id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["pass", "fail", "warning", "inconclusive", "not_applicable"]}, "score": {"type": "number"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}, "rationale": {"type": "string"}, "evidence_event_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "evidence_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "evaluated_by": {"$ref": "#/$defs/actor"}}, "additionalProperties": true}},
        "summary": {"type": "object", "additionalProperties": true},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": true
    },
    "manifestFile": {
      "type": "object",
      "required": ["path", "media_type"],
      "properties": {
        "path": {"type": "string"},
        "media_type": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
