        "finalized_at": {"$ref": "#/$defs/timestamp"},
        "status": {"enum": ["planned", "in_progress", "completed", "aborted", "crashed", "invalid"]},
        "files": {"type": "array", "items": {"$ref": "#/$defs/manifestFile"}},
        "integrity": {"type": "object", "additionalProperties": true},
        "derived_from": {"type": "object", "additionalProperties": true},
        "producer": {"type": "object", "additionalProperties": true},
        "extensions": {"$ref": "#/$defs/extensions"}
      },
      "additionalProperties": true
    }
  }
