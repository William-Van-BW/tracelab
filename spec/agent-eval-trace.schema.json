        "file_identity": {"type": "string"},
        "content_capture": {"enum": ["full", "hash_only", "sampled", "metadata_only", "failed", "not_applicable"]},
        "error": {"type": "object", "additionalProperties": true},
        "artifact_ref": {"$ref": "#/$defs/artifactRef"}
      },
      "additionalProperties": true
    },
    "fsSnapshot": {
      "type": "object",
      "required": ["document_type", "spec_version", "run_id", "snapshot_id", "captured_at", "capture", "roots", "entries"],
      "properties": {
        "document_type": {"const": "fs_snapshot"},
        "spec_version": {"$ref": "#/$defs/specVersion"},
        "run_id": {"$ref": "#/$defs/id"},
        "snapshot_id": {"$ref": "#/$defs/id"},
